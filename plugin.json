{
  "workflow": {
    "nodes": [
      {
        "id": "plugin-metadata",
        "type": "modifier",
        "position": {
          "x": 240,
          "y": 160
        },
        "data": {
          "modifier": {
            "name": "Interfacial Line Defect Analysis",
            "key": "ilda",
            "icon": "HiCube",
            "author": "/",
            "license": "MIT",
            "version": "1.0.3",
            "homepage": "https://github.com/voltlabs-research/ilda",
            "description": ""
          }
        }
      },
      {
        "id": "trajectory-context",
        "type": "context",
        "position": {
          "x": 816,
          "y": 160
        },
        "data": {
          "context": {
            "source": "trajectory_dumps"
          }
        }
      },
      {
        "id": "foreach-trajectory-dumps",
        "type": "forEach",
        "position": {
          "x": 1088,
          "y": 208
        },
        "data": {
          "forEach": {
            "iterableSource": "{{ trajectory-context.trajectory_dumps }}"
          }
        }
      },
      {
        "id": "analysis-entrypoint",
        "type": "entrypoint",
        "position": {
          "x": 1696,
          "y": 208
        },
        "data": {
          "entrypoint": {
            "type": "executable",
            "binary": "ilda",
            "binaryObjectPath": "__UPLOAD_BINARY_OBJECT_PATH__",
            "binaryFileName": "ilda",
            "arguments": "{{ foreach-trajectory-dumps.currentValue.path }} {{ foreach-trajectory-dumps.outputPath }}",
            "timeout": -1
          }
        }
      },
      {
        "id": "primary-exposure",
        "type": "exposure",
        "position": {
          "x": 2016,
          "y": 208
        },
        "data": {
          "exposure": {
            "name": "Line Defects",
            "icon": "HiCube",
            "results": "bonds.parquet",
            "iterable": "",
            "properties": [
              {
                "key": "burgers_id",
                "label": "Burgers ID",
                "type": "number"
              },
              {
                "key": "magnitude",
                "label": "Burgers magnitude",
                "type": "number"
              },
              {
                "key": "step_height",
                "label": "Step height",
                "type": "number"
              },
              {
                "key": "ideal_step_height_a",
                "label": "Ideal step height A",
                "type": "number"
              },
              {
                "key": "ideal_step_height_b",
                "label": "Ideal step height B",
                "type": "number"
              },
              {
                "key": "length",
                "label": "Segment length",
                "type": "number"
              },
              {
                "key": "atom_a",
                "label": "Node A",
                "type": "number"
              },
              {
                "key": "atom_b",
                "label": "Node B",
                "type": "number"
              },
              {
                "key": "distance",
                "label": "Distance",
                "type": "number"
              }
            ]
          }
        }
      },
      {
        "id": "primary-export",
        "type": "export",
        "position": {
          "x": 2336,
          "y": 208
        },
        "data": {
          "export": {
            "exporter": "BondExporter",
            "type": "glb",
            "options": {
              "radius": 0.4,
              "colorBy": "color",
              "material": {
                "metallic": 0,
                "roughness": 0.8,
                "emissive": [
                  0,
                  0,
                  0
                ],
                "baseColor": [
                  1,
                  0.5,
                  0,
                  1
                ]
              }
            }
          }
        }
      },
      {
        "id": "summary-exposure",
        "type": "exposure",
        "position": {
          "x": 2016,
          "y": 420
        },
        "data": {
          "exposure": {
            "name": "Disconnection Modes",
            "icon": "HiTable",
            "results": "disconnection_summary.parquet",
            "iterable": ""
          }
        }
      }
    ],
    "edges": [
      {
        "id": "edge-context-foreach",
        "source": "trajectory-context",
        "sourceHandle": "output",
        "target": "foreach-trajectory-dumps",
        "targetHandle": "input"
      },
      {
        "id": "edge-foreach-entrypoint",
        "source": "foreach-trajectory-dumps",
        "sourceHandle": "output",
        "target": "analysis-entrypoint",
        "targetHandle": "input"
      },
      {
        "id": "edge-entrypoint-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "primary-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-exposure-export",
        "source": "primary-exposure",
        "sourceHandle": "output",
        "target": "primary-export",
        "targetHandle": "input"
      },
      {
        "id": "edge-entrypoint-summary",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "summary-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-plugin-metadata-trajectory-context",
        "source": "plugin-metadata",
        "sourceHandle": "output",
        "target": "trajectory-context",
        "targetHandle": "input"
      }
    ]
  },
  "interface": {
    "version": 2,
    "requires": [
      {
        "id": "grains",
        "capability": "volt/grain-segmentation@1",
        "bind": {
          "grains": "--grains",
          "grain_atoms": "--grain-atoms"
        }
      }
    ],
    "provides": {}
  }
}
